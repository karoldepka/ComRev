# ── LLM provider — pick ONE ───────────────────────────────────────────────────

# Option A: Anthropic (cloud)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Option B: Ollama (local, no API key needed)
# OLLAMA_MODEL=llama3.2          # any model pulled via `ollama pull <model>`
# OLLAMA_BASE_URL=http://localhost:11434

# ── Structable backend ────────────────────────────────────────────────────────
STRUCTABLE_BACKEND_URL=http://localhost:3001

# ── Next.js side — set this in structable/.env.local ─────────────────────────
# LANGGRAPH_URL=http://localhost:2024
