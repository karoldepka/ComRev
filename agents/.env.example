# ── LLM provider ─────────────────────────────────────────────────────────────
# Default: Ollama (local). Make sure `ollama serve` is running.
OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434   # override if Ollama runs elsewhere

# To use Anthropic instead: set ANTHROPIC_API_KEY and unset OLLAMA_MODEL
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Structable backend ────────────────────────────────────────────────────────
STRUCTABLE_BACKEND_URL=http://localhost:3001

# ── Next.js side — set this in structable/.env.local ─────────────────────────
# AGENTS_URL=http://localhost:8001/copilotkit
