# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Next.js (public — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql

# GitHub (for fetching repo metadata)
GITHUB_TOKEN=your-github-token
GH_PAT=your-github-pat-for-pushing

# Search (used by AI fill feature)
TAVILY_API_KEY=your-tavily-api-key

# AI keys — stored CLIENT-SIDE in localStorage by the user, never sent to backend
# Users provide these at fill-time via the UI
